---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import { words } from '../data/words';

const gold = path.join(process.cwd(), 'public', 'data', 'gold');
const indice = JSON.parse(fs.readFileSync(path.join(gold, 'indice.json'), 'utf8'));
const atlante = JSON.parse(fs.readFileSync(path.join(gold, 'atlante.json'), 'utf8'));
const slugGold = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const perSlug = new Map(words.map(w => [slugGold(w.slug), w]));
const risposte = indice.parole.reduce((s: number, p: any) => s + p.risposte_valide, 0);
const numero = (n: number) => n.toLocaleString('it-IT');

// tessere in ordine di quanto la parola divide la provincia (atlante.json è già ordinato così)
const tessere = atlante.parole.map((p: any, i: number) => {
  const w = perSlug.get(p.slug);
  const varianti = p.varianti.filter((v: any) => v[0] !== 'Altre forme');
  return {
    slug: p.slug, href: `/${encodeURIComponent(w?.slug ?? p.parola)}`, nome: (w?.name ?? p.parola).replace(/^L'/, "l'"),
    rango: i + 1, varianti: varianti.slice(0, 3).map((v: any) => v[0]), altre: Math.max(0, varianti.length - 3),
  };
});
---

<Layout title="Atlante del bergamasco">
  <div class="contenitore">
    <header class="hero">
      <h1 class="hero-titolo">Come si dice<br />a Bergamo?</h1>
      <p class="hero-testo">
        {numero(risposte)} risposte da tutta la provincia, per {tessere.length} parole di tutti i giorni.
        Ogni carta mostra quale parola si usa in ogni angolo, dalle valli alla Bassa, e dove passa il confine tra una e l'altra.
      </p>
    </header>

    <section id="parole" aria-labelledby="titolo-parole">
      <div class="atlante-testa">
        <h2 id="titolo-parole" class="atlante-titolo">Le parole</h2>
        <div class="ordine" role="group" aria-label="Ordina le parole">
          <button type="button" data-ordine="divide" aria-pressed="true">Dalla più divisa</button>
          <button type="button" data-ordine="alfa" aria-pressed="false">In ordine alfabetico</button>
        </div>
      </div>
      <ol class="atlante">
        {tessere.map(t => (
          <li data-nome={t.nome.toLowerCase()} data-rango={t.rango}>
            <a href={t.href} class="tessera">
              <canvas data-slug={t.slug} aria-hidden="true"></canvas>
              <span class="tessera-nome">{t.nome}</span>
              <span class="tessera-varianti">
                {t.varianti.join(', ')}{t.altre > 0 && ` e altre ${t.altre}`}
              </span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section id="metodo" class="metodo" aria-labelledby="titolo-metodo">
      <h2 id="titolo-metodo" class="atlante-titolo">Come leggere le carte</h2>
      <div class="metodo-colonne">
        <div>
          <h3>Il colore</h3>
          <p>Ogni colore è una parola. Dove il colore è pieno quasi tutti dicono la stessa cosa; dove è pallido le forme convivono, oppure le risposte sono poche.</p>
        </div>
        <div>
          <h3>Gli esagoni</h3>
          <p>La provincia è divisa in esagoni di circa 0,7 km². Ogni risposta è collocata a caso nelle zone abitate del suo comune, secondo le sezioni di censimento ISTAT 2021, e ogni esagono fa la media delle risposte vicine.</p>
        </div>
        <div>
          <h3>Le linee nere</h3>
          <p>Segnano i confini netti: passandoli, la parola cambia di colpo. Dove la linea manca il passaggio è graduale, e due forme si sentono entrambe.</p>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .hero { margin: 72px 0 96px; }
  .hero-titolo {
    font-family: var(--serif); font-weight: 800; font-style: italic;
    font-size: clamp(60px, 11vw, 150px); line-height: 0.92; letter-spacing: -0.035em; margin: 0 0 32px -0.04em;
    font-variation-settings: "opsz" 96;
  }
  .hero-testo { font-size: clamp(19px, 2.1vw, 23px); line-height: 1.45; max-width: 56ch; margin: 0; }

  .atlante-testa { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 28px; }
  .atlante-titolo { font-family: var(--serif); font-weight: 500; font-size: clamp(30px, 4vw, 44px); margin: 0; letter-spacing: -0.01em; }
  .ordine { display: inline-flex; border: 1px solid var(--inchiostro); border-radius: 999px; padding: 2px; }
  .ordine button { padding: 6px 16px; border-radius: 999px; font-size: 15px; }
  .ordine button[aria-pressed="true"] { background: var(--inchiostro); color: var(--carta); }

  .atlante { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 40px 24px; }
  .tessera { display: block; text-decoration: none; }
  .tessera canvas { display: block; width: 100%; aspect-ratio: 1 / 1.08; border-radius: 16px; background: var(--carta-2); transition: transform .25s ease; }
  .tessera:hover canvas { transform: translateY(-4px); }
  .tessera-nome { display: block; margin-top: 12px; font-family: var(--serif); font-style: italic; font-weight: 700; font-size: 26px; line-height: 1.1; }
  .tessera:hover .tessera-nome { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  .tessera-varianti { display: block; margin-top: 4px; color: var(--grafite); font-size: 15px; }
  @media (max-width: 560px) {
    .hero { margin: 40px 0 64px; }
    .atlante { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 14px; }
    .tessera-nome { font-size: 21px; }
    .tessera-varianti { font-size: 14px; }
  }

  .metodo { margin-top: 120px; }
  .metodo-colonne { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 32px 48px; margin-top: 28px; }
  .metodo h3 { font-family: var(--serif); font-style: italic; font-weight: 600; font-size: 24px; margin: 0 0 8px; }
  .metodo p { margin: 0; color: var(--grafite); max-width: 46ch; }
</style>

<script>
  import * as d3 from "d3";
  import { TERRA, canvas2d, coloreVariante, json, riavvolgi, velatura } from "../lib/atlante";

  async function disegna() {
    const [atl, confini] = await Promise.all([json("/data/gold/atlante.json"), json("/data/bergamo.geojson")]);
    riavvolgi(confini);
    const centri: [number, number][] = atl.centri;
    const perSlug = new Map<string, any>(atl.parole.map((p: any) => [p.slug, p]));
    const tele = [...document.querySelectorAll<HTMLCanvasElement>(".tessera canvas")];
    const w = tele[0]?.clientWidth || 200, h = w * 1.08;
    const proj = d3.geoMercator().fitExtent([[10, 10], [w - 10, h - 10]], confini);
    const xy = centri.map(c => proj(c)!);
    // lato di un esagono H3 di risoluzione 8: ~0,46 km, un po' ridotto per lasciare il margine di carta
    const lato = 0.461 / (111.32 * Math.cos(45.7 * Math.PI / 180));
    const r = 0.92 * Math.abs(proj([9.8 + lato, 45.7])![0] - proj([9.8, 45.7])![0]);
    const esagono = (ctx: CanvasRenderingContext2D, x: number, y: number) => {
      ctx.moveTo(x, y - r);
      for (let k = 1; k < 6; k++) ctx.lineTo(x + r * Math.sin(k * Math.PI / 3), y - r * Math.cos(k * Math.PI / 3));
      ctx.closePath();
    };
    for (const c of tele) {
      const p = perSlug.get(c.dataset.slug!);
      if (!p) continue;
      const ctx = canvas2d(c, w, h);
      c.style.width = "100%"; c.style.height = "auto";
      const path = d3.geoPath(proj, ctx);
      ctx.beginPath(); path(confini); ctx.fillStyle = TERRA; ctx.fill();
      const vel = p.varianti.map((v: any, i: number) => velatura(coloreVariante(v[0], i)));
      const fasce = [0.05, 0.35, 0.65, 1];
      // un percorso per colore: poche chiamate di riempimento anche con 3.000 esagoni
      const gruppi = new Map<string, number[]>();
      for (let i = 0; i < p.celle.length; i++) {
        const k = p.celle.charCodeAt(i) - 48;
        const col = vel[k >> 2](fasce[k & 3]);
        if (!gruppi.has(col)) gruppi.set(col, []);
        gruppi.get(col)!.push(i);
      }
      for (const [col, idx] of gruppi) {
        ctx.beginPath();
        for (const i of idx) esagono(ctx, xy[i][0], xy[i][1]);
        ctx.fillStyle = col; ctx.fill();
      }
    }
  }
  disegna();

  const lista = document.querySelector<HTMLOListElement>(".atlante")!;
  document.querySelectorAll<HTMLButtonElement>(".ordine button").forEach(b => b.addEventListener("click", () => {
    document.querySelectorAll(".ordine button").forEach(x => x.setAttribute("aria-pressed", String(x === b)));
    const voci = [...lista.children] as HTMLElement[];
    voci.sort((x, y) => b.dataset.ordine === "alfa"
      ? x.dataset.nome!.localeCompare(y.dataset.nome!, "it")
      : Number(x.dataset.rango) - Number(y.dataset.rango));
    lista.append(...voci);
  }));
</script>
