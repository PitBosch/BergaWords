---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import HexMap from '../components/HexMap.astro';
import { words } from '../data/words';

export async function getStaticPaths() {
  return words.map(word => ({
    params: { word: word.slug },
    props: { word }
  }));
}

const { word } = Astro.props;

// stesso slug dei file in public/data/gold (build/db.py: slug)
const goldSlug = word.slug.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

// numeri per il testo d'apertura, letti dall'export gold al momento della build
const gold = path.join(process.cwd(), 'public', 'data', 'gold');
const indice = JSON.parse(fs.readFileSync(path.join(gold, 'indice.json'), 'utf8'));
const voce = indice.parole.find((p: any) => p.slug === goldSlug);
const esagoni = JSON.parse(fs.readFileSync(path.join(gold, 'esagoni', `${goldSlug}.json`), 'utf8'));
const varianti = esagoni.livelli.lessema.varianti.filter((v: any) => v.variante !== 'Altre forme');
const rango = voce?.rango_divisivita ?? 0;
const totale = indice.parole.length;
const pct = (x: number) => `${Math.round(x * 100)}%`;
const numero = (n: number) => n.toLocaleString('it-IT');

const [a, b, c] = varianti;
let apertura = `Su ${numero(voce?.risposte_valide ?? 0)} risposte da ${voce?.comuni_con_risposte ?? 0} comuni, `;
apertura += b
  ? `il ${pct(a.quota_provincia)} dice «${a.variante}» e il ${pct(b.quota_provincia)} «${b.variante}»${c && c.quota_provincia >= 0.05 ? `; poi viene «${c.variante}», col ${pct(c.quota_provincia)}` : ''}.`
  : `quasi tutti dicono «${a.variante}».`;
const giudizio = rango <= Math.ceil(totale / 4)
  ? `È tra le parole che dividono di più la provincia: ${rango}ª su ${totale}.`
  : rango > totale - Math.ceil(totale / 4)
    ? `È tra le parole più uniformi: ${rango}ª su ${totale} per quanto divide la provincia.`
    : `Per quanto divide la provincia è ${rango}ª su ${totale}.`;

const i = words.findIndex(w => w.slug === word.slug);
const prima = i > 0 ? words[i - 1] : null;
const dopo = i < words.length - 1 ? words[i + 1] : null;
const titolo = word.name.replace(/^L'/, "l'");
---

<Layout title={`Come si dice ${word.name}?`} description={`${apertura} Mappa interattiva del dialetto bergamasco.`}>
  <div class="contenitore">
    <nav class="briciole" aria-label="Navigazione tra le parole">
      <a href="/#parole">Tutte le parole</a>
      <span class="briciole-vicine">
        {prima && <a href={`/${encodeURIComponent(prima.slug)}`} rel="prev">{prima.name}</a>}
        {dopo && <a href={`/${encodeURIComponent(dopo.slug)}`} rel="next">{dopo.name}</a>}
      </span>
    </nav>

    <header class="apertura">
      <p class="apertura-domanda">Come si dice</p>
      <h1 class="apertura-parola">{titolo}<span aria-hidden="true">?</span></h1>
      <p class="apertura-testo">{apertura} {giudizio}</p>
    </header>

    <HexMap slug={goldSlug} nome={word.name} />
  </div>
</Layout>

<style>
  .briciole { display: flex; justify-content: space-between; gap: 16px; margin-top: 40px; font-size: 15px; color: var(--grafite); }
  .briciole a { color: var(--grafite); text-decoration: none; }
  .briciole a:hover { color: var(--inchiostro); text-decoration: underline; text-underline-offset: 4px; }
  .briciole-vicine { display: flex; gap: 20px; }
  .briciole-vicine a[rel="prev"]::before { content: "‹ "; }
  .briciole-vicine a[rel="next"]::after { content: " ›"; }
  .apertura { margin: 56px 0 40px; max-width: 980px; }
  .apertura-domanda { font-family: var(--serif); font-size: clamp(22px, 3vw, 32px); margin: 0; color: var(--grafite); }
  .apertura-parola {
    font-family: var(--serif); font-style: italic; font-weight: 800;
    font-size: clamp(64px, 13vw, 168px); line-height: 0.9; letter-spacing: -0.03em; margin: 0.04em 0 0.18em -0.04em;
    font-variation-settings: "opsz" 96;
  }
  .apertura-parola span { font-weight: 400; color: var(--grafite); margin-left: 0.02em; }
  .apertura-testo { font-size: clamp(18px, 2vw, 21px); line-height: 1.45; max-width: 58ch; margin: 0; }
  @media (max-width: 560px) { .briciole { margin-top: 24px; } .briciole-vicine { gap: 12px; } .apertura { margin: 36px 0 28px; } }
</style>
