---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Atlante del dialetto bergamasco: come si dicono 29 parole nei 243 comuni della provincia di Bergamo" } = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eef0ec" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Schibsted+Grotesk:wght@400..700&display=swap" rel="stylesheet" />
    <title>{title} | BergaWords</title>
  </head>
  <body>
    <header class="testata">
      <a href="/" class="marchio" aria-label="BergaWords, torna all'atlante">
        <span class="marchio-nome">BergaWords</span>
        <span class="marchio-sotto">atlante del bergamasco</span>
      </a>
      <nav class="testata-nav">
        <a href="/#parole">Le parole</a>
        <a href="/#metodo">Come leggere le carte</a>
        <a href="https://github.com/PitBosch/BergaWords" target="_blank" rel="noopener">Codice e dati</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="piede">
      <p>BergaWords raccoglie le risposte di chi parla bergamasco e le mette in carta, comune per comune.</p>
      <p>Popolazione: censimento ISTAT 2021. Griglia: esagoni H3 di circa 0,7 km².</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --carta: #eef0ec;
    --carta-2: #e4e8e2;
    --terra: #dadfd8;
    --inchiostro: #1c2433;
    --grafite: #5b6270;
    --nebbia: #8b919b;
    --filo: #c9cfc8;
    --serif: "Bodoni Moda", "Bodoni 72", "Didot", Georgia, serif;
    --sans: "Schibsted Grotesk", system-ui, -apple-system, "Segoe UI", sans-serif;
    --misura: 1180px;
    color-scheme: light;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body {
    margin: 0;
    background: var(--carta);
    color: var(--inchiostro);
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; }
  :focus-visible { outline: 2px solid var(--inchiostro); outline-offset: 3px; border-radius: 2px; }
  button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; padding: 0; }
  .contenitore { max-width: var(--misura); margin: 0 auto; padding: 0 24px; }
  @media (max-width: 560px) { .contenitore { padding: 0 16px; } }

  .testata {
    max-width: var(--misura); margin: 0 auto; padding: 22px 24px 0;
    display: flex; align-items: baseline; justify-content: space-between; gap: 24px; flex-wrap: wrap;
  }
  .marchio { text-decoration: none; display: flex; align-items: baseline; gap: 10px; }
  .marchio-nome { font-family: var(--serif); font-style: italic; font-weight: 600; font-size: 24px; letter-spacing: -0.01em; }
  .marchio-sotto { font-size: 14px; color: var(--grafite); }
  .testata-nav { display: flex; gap: 20px; font-size: 15px; }
  .testata-nav a { text-decoration: none; color: var(--grafite); }
  .testata-nav a:hover { color: var(--inchiostro); text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 560px) {
    .testata { padding: 16px 16px 0; }
    .marchio-sotto { display: none; }
    .testata-nav { gap: 14px; font-size: 14px; }
    .testata-nav a:nth-child(2) { display: none; }
  }

  .piede {
    max-width: var(--misura); margin: 96px auto 0; padding: 24px 24px 48px;
    border-top: 1px solid var(--filo); color: var(--grafite); font-size: 14px;
    display: flex; flex-wrap: wrap; gap: 8px 40px;
  }
  .piede p { margin: 0; max-width: 60ch; }
</style>
