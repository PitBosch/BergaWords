---
// Mappa a esagoni H3 della stima (public/data/gold/esagoni*): parola più detta con l'intensità
// del consenso, percentuale di ogni parola, piccole mappe per variante, pannello per luogo.
interface Props {
  slug: string;   // slug dei file gold, es. "l-asso-di-ori"
  nome: string;
}
const { slug, nome } = Astro.props;
---

<section class="hexviz" data-slug={slug} data-nome={nome}>
  <div class="hv-bar">
    <div class="hv-seg" role="group" aria-label="Livello">
      <button type="button" data-livello="lessema" aria-pressed="true">Parola</button>
      <button type="button" data-livello="pronuncia" aria-pressed="false">Pronuncia</button>
    </div>
    <label class="hv-search">
      <span class="hv-sr">Cerca il tuo paese</span>
      <input type="search" list={`hv-comuni-${slug}`} placeholder="Il tuo paese…" autocomplete="off" />
      <datalist id={`hv-comuni-${slug}`}></datalist>
    </label>
    <label class="hv-check">
      <input type="checkbox" class="hv-iso" checked />
      <span>Confini netti</span>
    </label>
  </div>

  <div class="hv-summary">
    <p class="hv-kicker">In tutta la provincia</p>
    <div class="hv-stack" aria-hidden="true"></div>
    <div class="hv-chips" role="group" aria-label="Scegli cosa colorare"></div>
  </div>

  <div class="hv-main">
    <div class="hv-mapwrap">
      <canvas class="hv-map" role="img" aria-label={`Mappa di come si dice ${nome} nella provincia di Bergamo`}></canvas>
      <div class="hv-ramp" hidden>
        <span class="hv-ramp-title"></span>
        <div class="hv-ramp-bar"></div>
        <div class="hv-ramp-ticks"><span>0%</span><span>25%</span><span>50%</span><span>75%</span><span>100%</span></div>
      </div>
      <p class="hv-hint">Passa sopra la mappa o tocca un punto · le zone chiare hanno pochi dati</p>
      <div class="hv-loading">Caricamento della mappa…</div>
    </div>
    <aside class="hv-panel" aria-live="polite"></aside>
  </div>

  <h3 class="hv-h3">Dove si dice ciascuna parola</h3>
  <p class="hv-sub">Ogni mappa mostra la percentuale di persone che usano quella parola, da 0 a 100%. Tocca una mappa per ingrandirla.</p>
  <div class="hv-multiples"></div>

  <div class="hv-quotes" hidden>
    <h3 class="hv-h3">Dicono i partecipanti</h3>
    <div class="hv-quotes-list"></div>
  </div>

  <details class="hv-table">
    <summary>Tabella per comune</summary>
    <div class="hv-table-scroll">
      <table>
        <thead><tr><th>Comune</th><th>Più detta</th><th class="num">%</th><th>Seconda</th><th class="num">%</th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
  </details>

  <p class="hv-note">
    Ogni risposta è collocata a caso nelle zone abitate del suo comune (sezioni di censimento ISTAT 2021),
    poi per ogni esagono di circa 0,7 km² si calcola la media delle risposte vicine. Il colore indica la parola
    più detta, l'intensità quanto è condivisa. Le linee scure sono i confini netti tra due parole.
  </p>
</section>

<style is:global>
  .hexviz {
    --surface: #fcfcfb;
    --ink: #0b0b0b;
    --ink-2: #52514e;
    --muted: #898781;
    --grid: #e1e0d9;
    --land: #eceae4;
    --ring: rgba(11, 11, 11, 0.1);
    --accent: #b45309;
    color: var(--ink);
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  .hexviz .hv-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .hexviz .hv-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-bottom: 20px; }
  .hexviz .hv-seg { display: inline-flex; padding: 3px; border-radius: 10px; background: #f0efec; }
  .hexviz .hv-seg button {
    padding: 6px 14px; border-radius: 8px; font-size: 14px; font-weight: 500; color: var(--ink-2);
    transition: background .15s, color .15s;
  }
  .hexviz .hv-seg button[aria-pressed="true"] { background: var(--surface); color: var(--ink); box-shadow: 0 1px 2px var(--ring); }
  .hexviz .hv-search input {
    width: 220px; max-width: 100%; padding: 7px 12px; border-radius: 10px; font-size: 14px;
    border: 1px solid var(--grid); background: var(--surface);
  }
  .hexviz .hv-search input:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  .hexviz .hv-check { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; color: var(--ink-2); cursor: pointer; }

  .hexviz .hv-kicker { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin-bottom: 8px; }
  .hexviz .hv-stack { display: flex; gap: 2px; height: 14px; margin-bottom: 14px; }
  .hexviz .hv-stack > span { display: block; height: 100%; min-width: 2px; }
  .hexviz .hv-stack > span:first-child { border-radius: 4px 0 0 4px; }
  .hexviz .hv-stack > span:last-child { border-radius: 0 4px 4px 0; }
  .hexviz .hv-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
  .hexviz .hv-chip {
    display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px;
    border: 1px solid var(--grid); background: var(--surface); font-size: 14px; color: var(--ink);
    transition: border-color .15s, box-shadow .15s;
  }
  .hexviz .hv-chip:hover { border-color: var(--muted); }
  .hexviz .hv-chip[aria-pressed="true"] { border-color: var(--ink); box-shadow: 0 0 0 1px var(--ink); }
  .hexviz .hv-chip .sw { width: 12px; height: 12px; border-radius: 3px; flex: none; }
  .hexviz .hv-chip .pc { color: var(--ink-2); font-variant-numeric: tabular-nums; }

  .hexviz .hv-main { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: 20px; align-items: start; }
  @media (max-width: 860px) { .hexviz .hv-main { grid-template-columns: minmax(0, 1fr); } }
  .hexviz .hv-mapwrap { position: relative; min-height: 320px; }
  .hexviz .hv-map { display: block; margin: 0 auto; max-width: 100%; touch-action: manipulation; cursor: crosshair; }
  .hexviz .hv-loading {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    color: var(--muted); font-size: 14px;
  }
  .hexviz .hv-hint { font-size: 12px; color: var(--muted); margin-top: 6px; }
  .hexviz .hv-ramp {
    position: absolute; left: 0; top: 0; width: 200px; padding: 8px 10px; border-radius: 10px;
    background: rgba(252, 252, 251, .92); box-shadow: 0 0 0 1px var(--ring);
  }
  .hexviz .hv-ramp-title { display: block; font-size: 12px; font-weight: 600; margin-bottom: 6px; }
  .hexviz .hv-ramp-bar { height: 10px; border-radius: 4px; }
  .hexviz .hv-ramp-ticks { display: flex; justify-content: space-between; font-size: 11px; color: var(--muted); margin-top: 3px; font-variant-numeric: tabular-nums; }

  .hexviz .hv-panel {
    background: var(--surface); border-radius: 16px; padding: 16px; box-shadow: 0 0 0 1px var(--ring);
    position: sticky; top: 84px;
  }
  .hexviz .hv-panel .p-k { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  .hexviz .hv-panel .p-t { font-size: 18px; font-weight: 600; margin: 2px 0 10px; display: flex; justify-content: space-between; gap: 8px; align-items: baseline; }
  .hexviz .hv-panel .p-x { font-size: 12px; font-weight: 500; color: var(--accent); }
  .hexviz .hv-panel .p-big { font-size: 28px; font-weight: 700; line-height: 1.1; }
  .hexviz .hv-panel .p-bigp { font-size: 14px; color: var(--ink-2); margin-bottom: 14px; }
  .hexviz .hv-panel .p-row { display: grid; grid-template-columns: 1fr auto; gap: 2px 10px; margin-bottom: 8px; font-size: 14px; }
  .hexviz .hv-panel .p-row .n { display: flex; align-items: center; gap: 6px; min-width: 0; }
  .hexviz .hv-panel .p-row .n i { width: 10px; height: 2px; border-radius: 1px; flex: none; }
  .hexviz .hv-panel .p-row .n span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hexviz .hv-panel .p-row .v { font-weight: 600; font-variant-numeric: tabular-nums; }
  .hexviz .hv-panel .p-row .b { grid-column: 1 / -1; height: 6px; border-radius: 3px; background: #f0efec; overflow: hidden; }
  .hexviz .hv-panel .p-row .b > span { display: block; height: 100%; border-radius: 3px; }
  .hexviz .hv-panel .p-rel { font-size: 12px; color: var(--ink-2); margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--grid); }

  .hexviz .hv-h3 { font-size: 20px; font-weight: 700; margin: 40px 0 4px; }
  .hexviz .hv-sub { font-size: 14px; color: var(--ink-2); margin-bottom: 16px; }
  .hexviz .hv-multiples { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 14px; }
  .hexviz .hv-multiples .mm {
    text-align: left; padding: 10px; border-radius: 14px; background: var(--surface);
    box-shadow: 0 0 0 1px var(--ring); transition: box-shadow .15s, transform .15s;
  }
  .hexviz .hv-multiples .mm:hover { transform: translateY(-2px); box-shadow: 0 0 0 1px var(--muted), 0 6px 16px rgba(0,0,0,.06); }
  .hexviz .hv-multiples .mm[aria-pressed="true"] { box-shadow: 0 0 0 2px var(--ink); }
  .hexviz .hv-multiples .mm canvas { display: block; width: 100%; }
  .hexviz .hv-multiples .mm .t { display: flex; justify-content: space-between; gap: 6px; font-size: 14px; font-weight: 600; margin-top: 6px; }
  .hexviz .hv-multiples .mm .t span:last-child { color: var(--ink-2); font-weight: 500; font-variant-numeric: tabular-nums; }

  .hexviz .hv-quotes-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; }
  .hexviz .hv-quotes-list figure { background: var(--surface); border-radius: 14px; padding: 14px; box-shadow: 0 0 0 1px var(--ring); font-size: 14px; }
  .hexviz .hv-quotes-list figcaption { font-size: 12px; color: var(--muted); margin-top: 6px; }

  .hexviz .hv-table { margin-top: 32px; font-size: 14px; }
  .hexviz .hv-table summary { cursor: pointer; font-weight: 600; color: var(--ink-2); }
  .hexviz .hv-table-scroll { max-height: 420px; overflow: auto; margin-top: 10px; border-radius: 12px; box-shadow: 0 0 0 1px var(--ring); }
  .hexviz .hv-table table { width: 100%; border-collapse: collapse; background: var(--surface); }
  .hexviz .hv-table th, .hexviz .hv-table td { padding: 6px 10px; text-align: left; border-bottom: 1px solid var(--grid); }
  .hexviz .hv-table th { position: sticky; top: 0; background: #f6f5f1; font-weight: 600; }
  .hexviz .hv-table .num { text-align: right; font-variant-numeric: tabular-nums; }
  .hexviz .hv-note { font-size: 13px; color: var(--muted); margin-top: 20px; max-width: 70ch; }
  @media (max-width: 560px) {
    .hexviz .hv-multiples { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .hexviz .hv-ramp { position: static; width: 100%; margin-bottom: 8px; }
    .hexviz .hv-search input { width: 100%; }
    .hexviz .hv-search { flex: 1 1 100%; }
  }
</style>

<script>
  // ---------------------------------------------------------------- colori
  // Palette categoriale validata (ordine fisso, per diffusione in provincia); oltre l'ottava: grigio.
  const PALETTE = ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#6250d6", "#e34948"];
  const GRIGIO = "#b9b5ad";
  const ALTRE = "Altre forme";
  const SURFACE = "#fcfcfb";
  const LAND = "#eceae4";
  const INK = "#0b0b0b";
  const CITTA = ["Bergamo", "Treviglio", "Romano di Lombardia", "Albino", "Clusone", "Lovere", "Zogno",
    "San Pellegrino Terme", "Sarnico", "Branzi", "Dalmine", "Schilpario", "Caravaggio"];

  type Lab = [number, number, number];
  const hex2rgb = (h: string): Lab => [1, 3, 5].map(i => parseInt(h.slice(i, i + 2), 16) / 255) as Lab;
  const lin = (c: number) => (c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4);
  const gam = (c: number) => (c <= 0.0031308 ? 12.92 * c : 1.055 * c ** (1 / 2.4) - 0.055);
  function toOklab(h: string): Lab {
    const [r, g, b] = hex2rgb(h).map(lin);
    const l = Math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);
    const m = Math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);
    const s = Math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);
    return [0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s,
      1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s,
      0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s];
  }
  function fromOklab([L, a, b]: Lab): string {
    const l = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3;
    const m = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3;
    const s = (L - 0.0894841775 * a - 1.291485548 * b) ** 3;
    const rgb = [4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
      -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
      -0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s];
    return "#" + rgb.map(c => Math.round(Math.min(1, Math.max(0, gam(c))) * 255).toString(16).padStart(2, "0")).join("");
  }
  const mix = (a: Lab, b: Lab, t: number): Lab => [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t];

  // Rampa sequenziale a una tinta: quasi superficie a 0%, la tinta piena a ~60%, più scura a 100%.
  function rampa(hex: string): (t: number) => string {
    const c = toOklab(hex);
    const chiaro: Lab = [0.965, c[1] * 0.08, c[2] * 0.08];
    const scuro: Lab = [Math.max(0.3, c[0] - 0.22), c[1] * 0.9, c[2] * 0.9];
    const cache = new Map<number, string>();
    return t => {
      const k = Math.round(Math.min(1, Math.max(0, t)) * 100);
      let v = cache.get(k);
      if (!v) {
        const x = k / 100;
        v = fromOklab(x < 0.6 ? mix(chiaro, c, x / 0.6) : mix(c, scuro, (x - 0.6) / 0.4));
        cache.set(k, v);
      }
      return v;
    };
  }
  const pct = (x: number) => (x >= 0.995 ? "100%" : x < 0.005 ? "<1%" : `${Math.round(x * 100)}%`);

  // ---------------------------------------------------------------- dati
  type Variante = { variante: string; lessema: string; quota_provincia: number; colore: string };
  type Livello = { varianti: Variante[]; celle: number[][]; isoglosse: number[][]; quote: number[][] };
  type Esagono = { comune: string; pop: number; lon: number[]; lat: number[]; clon: number; clat: number };

  const cacheGeo: Record<string, Promise<any>> = {};
  const json = (u: string) => (cacheGeo[u] ??= fetch(u).then(r => { if (!r.ok) throw new Error(u); return r.json(); }));

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text != null) e.textContent = text;
    return e;
  }

  // ---------------------------------------------------------------- geometria e disegno
  class Proiezione {
    x0 = 0; y0 = 0; s = 1; w = 0; h = 0; kx = 1;
    constructor(public esa: Esagono[], larghezza: number, altezzaMax: number) {
      let a = Infinity, b = -Infinity, c = Infinity, d = -Infinity;
      for (const e of esa) for (let i = 0; i < e.lon.length; i++) {
        a = Math.min(a, e.lon[i]); b = Math.max(b, e.lon[i]); c = Math.min(c, e.lat[i]); d = Math.max(d, e.lat[i]);
      }
      this.kx = Math.cos(((c + d) / 2) * Math.PI / 180);
      const pad = 6;
      const dx = (b - a) * this.kx, dy = d - c;
      this.s = Math.min((larghezza - 2 * pad) / dx, (altezzaMax - 2 * pad) / dy);
      this.w = Math.round(dx * this.s + 2 * pad);
      this.h = Math.round(dy * this.s + 2 * pad);
      this.x0 = a * this.kx - pad / this.s;
      this.y0 = d + pad / this.s;
    }
    px(lon: number, lat: number): [number, number] {
      return [(lon * this.kx - this.x0) * this.s, (this.y0 - lat) * this.s];
    }
  }

  type Disegno = {
    colore: (i: number) => string;
    alfa?: (i: number) => number;
    iso?: number[][] | null;
    evidenzia?: Set<number> | null;
    punto?: number | null;
    etichette?: { x: number; y: number; t: string; forte?: boolean; colore?: string }[];
    sfondo?: any;
  };

  function prepara(canvas: HTMLCanvasElement, pr: Proiezione) {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = pr.w * dpr; canvas.height = pr.h * dpr;
    canvas.style.height = `${pr.h}px`;
    canvas.style.width = `${pr.w}px`;
    const ctx = canvas.getContext("2d")!;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    return ctx;
  }

  function disegna(ctx: CanvasRenderingContext2D, pr: Proiezione, poli: [number, number][][], centri: [number, number][], d: Disegno) {
    ctx.clearRect(0, 0, pr.w, pr.h);
    // territorio della provincia, comune per comune (le zone senza esagoni restano grigie)
    if (d.sfondo) {
      ctx.fillStyle = LAND; ctx.strokeStyle = SURFACE; ctx.lineWidth = 0.6;
      for (const f of d.sfondo.features) {
        const g = f.geometry;
        const anelli = g.type === "Polygon" ? [g.coordinates] : g.coordinates;
        ctx.beginPath();
        for (const p of anelli) for (const r of p) r.forEach(([lo, la]: number[], k: number) => {
          const [x, y] = pr.px(lo, la); k ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
        });
        ctx.fill(); ctx.stroke();
      }
    }
    // esagoni, leggermente rimpiccioliti: il margine fa da separatore
    const rid = 0.9;
    for (let i = 0; i < poli.length; i++) {
      const [cx, cy] = centri[i];
      ctx.beginPath();
      poli[i].forEach(([x, y], k) => {
        const X = cx + (x - cx) * rid, Y = cy + (y - cy) * rid;
        k ? ctx.lineTo(X, Y) : ctx.moveTo(X, Y);
      });
      ctx.closePath();
      ctx.globalAlpha = 1;
      ctx.fillStyle = SURFACE; ctx.fill();
      ctx.globalAlpha = d.alfa ? d.alfa(i) : 1;
      ctx.fillStyle = d.colore(i); ctx.fill();
    }
    ctx.globalAlpha = 1;
    // isoglosse nette: il lato in comune tra due esagoni
    if (d.iso) {
      ctx.strokeStyle = "rgba(11,11,11,.8)"; ctx.lineWidth = 1.6; ctx.lineCap = "round";
      ctx.beginPath();
      for (const [a, b, netta] of d.iso) {
        if (!netta) continue;
        const [ax, ay] = centri[a], [bx, by] = centri[b];
        const dx = bx - ax, dy = by - ay, l = Math.hypot(dx, dy);
        if (l === 0) continue;
        const mx = (ax + bx) / 2, my = (ay + by) / 2, h = l / (2 * Math.sqrt(3));
        ctx.moveTo(mx - (dy / l) * h, my + (dx / l) * h);
        ctx.lineTo(mx + (dy / l) * h, my - (dx / l) * h);
      }
      ctx.stroke();
    }
    // comune evidenziato e punto sotto il cursore
    const contorno = (i: number, w: number, c: string) => {
      ctx.beginPath();
      poli[i].forEach(([x, y], k) => (k ? ctx.lineTo(x, y) : ctx.moveTo(x, y)));
      ctx.closePath(); ctx.lineWidth = w; ctx.strokeStyle = c; ctx.stroke();
    };
    if (d.evidenzia) for (const i of d.evidenzia) contorno(i, 1.2, "rgba(11,11,11,.55)");
    if (d.punto != null) { contorno(d.punto, 3, SURFACE); contorno(d.punto, 1.6, INK); }
    // etichette con alone, senza sovrapposizioni
    if (d.etichette) {
      const usati: number[][] = [];
      ctx.textAlign = "center"; ctx.textBaseline = "middle"; ctx.lineJoin = "round";
      for (const e of d.etichette) {
        ctx.font = e.forte ? "600 13px system-ui, sans-serif" : "11px system-ui, sans-serif";
        const w = ctx.measureText(e.t).width + (e.colore ? 14 : 0), h = e.forte ? 16 : 13;
        const box = [e.x - w / 2 - 3, e.y - h / 2 - 2, e.x + w / 2 + 3, e.y + h / 2 + 2];
        if (box[0] < 0 || box[2] > pr.w || box[1] < 0 || box[3] > pr.h) continue;
        if (usati.some(u => !(box[2] < u[0] || box[0] > u[2] || box[3] < u[1] || box[1] > u[3]))) continue;
        usati.push(box);
        const tx = e.x + (e.colore ? 7 : 0);
        ctx.lineWidth = 3.5; ctx.strokeStyle = "rgba(252,252,251,.92)"; ctx.strokeText(e.t, tx, e.y);
        ctx.fillStyle = e.forte ? INK : "#52514e"; ctx.fillText(e.t, tx, e.y);
        if (e.colore) {
          const x = tx - ctx.measureText(e.t).width / 2 - 9;
          ctx.beginPath(); ctx.arc(x, e.y, 4.5, 0, 2 * Math.PI);
          ctx.fillStyle = e.colore; ctx.fill(); ctx.lineWidth = 2; ctx.strokeStyle = SURFACE; ctx.stroke();
        }
      }
    }
  }

  // ---------------------------------------------------------------- componente
  async function avvia(root: HTMLElement) {
    const slug = root.dataset.slug!;
    const nome = root.dataset.nome!;
    const q = <T extends Element>(s: string) => root.querySelector(s) as T;
    const canvas = q<HTMLCanvasElement>(".hv-map");
    const wrap = q<HTMLElement>(".hv-mapwrap");
    const panel = q<HTMLElement>(".hv-panel");

    let geo: any, parola: any, confini: any, commenti: any;
    try {
      [geo, parola, confini, commenti] = await Promise.all([
        json("/data/gold/esagoni.geojson"), json(`/data/gold/esagoni/${slug}.json`),
        json("/data/bergamo.geojson"), json("/data/gold/commenti.json").catch(() => ({})),
      ]);
    } catch {
      q<HTMLElement>(".hv-loading").textContent = "Impossibile caricare i dati della mappa.";
      return;
    }
    q<HTMLElement>(".hv-loading").remove();

    const esa: Esagono[] = geo.features.map((f: any) => {
      const r = f.geometry.coordinates[0].slice(0, -1);
      return {
        comune: f.properties.comune, pop: f.properties.popolazione,
        lon: r.map((p: number[]) => p[0]), lat: r.map((p: number[]) => p[1]),
        clon: r.reduce((s: number, p: number[]) => s + p[0], 0) / r.length,
        clat: r.reduce((s: number, p: number[]) => s + p[1], 0) / r.length,
      };
    });
    const perComune = new Map<string, number[]>();
    esa.forEach((e, i) => { if (!perComune.has(e.comune)) perComune.set(e.comune, []); perComune.get(e.comune)!.push(i); });
    const nomiComuni = [...perComune.keys()].sort((a, b) => a.localeCompare(b, "it"));
    const dl = q<HTMLDataListElement>("datalist");
    for (const c of nomiComuni) dl.append(Object.assign(document.createElement("option"), { value: c }));

    // stato
    let livello: "lessema" | "pronuncia" = "lessema";
    let fuoco: number | null = null;              // variante colorata in percentuale (null = più detta)
    let fisso: string | null = null;              // comune scelto con la ricerca o con un tocco
    let sotto: number | null = null;              // esagono sotto il cursore
    let mostraIso = true;

    let L: Livello, colori: string[], visibili: number[], rampe: ((t: number) => string)[];
    let pr: Proiezione, poli: [number, number][][], centri: [number, number][];

    function impostaLivello() {
      L = parola.livelli[livello];
      colori = L.varianti.map((v, i) => (v.variante === ALTRE || i >= PALETTE.length ? GRIGIO : PALETTE[i]));
      rampe = colori.map(rampa);
      const dominanti = new Set(L.celle.map(c => c[0]));
      visibili = L.varianti.map((_, i) => i)
        .filter(i => L.varianti[i].variante !== ALTRE && i < PALETTE.length &&
          (dominanti.has(i) || L.varianti[i].quota_provincia >= 0.02));
      if (fuoco != null && !visibili.includes(fuoco)) fuoco = null;
    }

    // quote di un comune: media degli esagoni pesata per popolazione
    function quoteComune(c: string) {
      const idx = perComune.get(c)!;
      const tot = idx.reduce((s, i) => s + Math.max(esa[i].pop, 1e-3), 0);
      const out = L.varianti.map(() => 0);
      let neff = 0;
      for (const i of idx) {
        const w = Math.max(esa[i].pop, 1e-3) / tot;
        L.quote[i].forEach((v, j) => (out[j] += (w * v) / 1000));
        neff += w * L.celle[i][4];
      }
      return { quote: out, neff };
    }

    // ---- riepilogo provinciale e selettori
    function riepilogo() {
      const stack = q<HTMLElement>(".hv-stack");
      stack.replaceChildren();
      L.varianti.forEach((v, i) => {
        if (v.quota_provincia <= 0) return;
        const s = el("span");
        s.style.flex = String(v.quota_provincia);
        s.style.background = colori[i];
        s.title = `${v.variante}: ${pct(v.quota_provincia)}`;
        stack.append(s);
      });
      const chips = q<HTMLElement>(".hv-chips");
      chips.replaceChildren();
      const tutte = el("button", "hv-chip", "Più detta in ogni zona");
      tutte.type = "button";
      tutte.setAttribute("aria-pressed", String(fuoco == null));
      tutte.onclick = () => { fuoco = null; aggiorna(); };
      chips.append(tutte);
      for (const i of visibili) {
        const b = el("button", "hv-chip");
        b.type = "button";
        b.setAttribute("aria-pressed", String(fuoco === i));
        const sw = el("span", "sw"); sw.style.background = colori[i];
        b.append(sw, el("span", "", L.varianti[i].variante), el("span", "pc", pct(L.varianti[i].quota_provincia)));
        b.onclick = () => { fuoco = fuoco === i ? null : i; aggiorna(); };
        chips.append(b);
      }
    }

    // ---- mappa principale
    function layout() {
      const larg = wrap.clientWidth;
      const altMax = Math.max(360, Math.min(window.innerHeight * 0.82, 820));
      pr = new Proiezione(esa, larg, altMax);
      poli = esa.map(e => e.lon.map((lo, k) => pr.px(lo, e.lat[k])));
      centri = esa.map(e => pr.px(e.clon, e.clat));
    }

    function etichetteVarianti() {
      const out: Disegno["etichette"] = [];
      for (const j of visibili) {
        let sx = 0, sy = 0, sw = 0;
        const mie: number[] = [];
        L.celle.forEach((c, i) => {
          if (c[0] !== j) return;
          mie.push(i);
          const w = c[1] * c[1];
          sx += centri[i][0] * w; sy += centri[i][1] * w; sw += w;
        });
        if (mie.length < 25) continue;
        const gx = sx / sw, gy = sy / sw;
        let best = mie[0], bd = Infinity;
        for (const i of mie) {
          const dd = (centri[i][0] - gx) ** 2 + (centri[i][1] - gy) ** 2 - 400 * L.celle[i][1];
          if (dd < bd) { bd = dd; best = i; }
        }
        out.push({ x: centri[best][0], y: centri[best][1], t: L.varianti[j].variante, forte: true, colore: colori[j] });
      }
      return out;
    }

    function etichetteCitta() {
      return CITTA.filter(c => perComune.has(c)).map(c => {
        const idx = perComune.get(c)!;
        let x = 0, y = 0, w = 0;
        for (const i of idx) { const p = Math.max(esa[i].pop, 1e-3); x += centri[i][0] * p; y += centri[i][1] * p; w += p; }
        return { x: x / w, y: y / w, t: c };
      });
    }

    const alfaConsenso = (i: number) => {
      const c = L.celle[i];
      if (c[5]) return 0.18;
      return 0.22 + 0.78 * Math.min(1, Math.max(0, (c[1] - 0.3) / 0.6));
    };

    function disegnaMappa() {
      const ctx = prepara(canvas, pr);
      const evid = fisso ? new Set(perComune.get(fisso)) : null;
      const base = { sfondo: confini, evidenzia: evid, punto: sotto };
      if (fuoco == null) {
        disegna(ctx, pr, poli, centri, {
          ...base, colore: i => colori[L.celle[i][0]], alfa: alfaConsenso, iso: mostraIso ? L.isoglosse : null,
          etichette: [...etichetteVarianti(), ...etichetteCitta()],
        });
      } else {
        const r = rampe[fuoco], j = fuoco;
        disegna(ctx, pr, poli, centri, {
          ...base, colore: i => r(L.quote[i][j] / 1000), alfa: i => (L.celle[i][5] ? 0.45 : 1), etichette: etichetteCitta(),
        });
      }
      const ramp = q<HTMLElement>(".hv-ramp");
      ramp.hidden = fuoco == null;
      if (fuoco != null) {
        q<HTMLElement>(".hv-ramp-title").textContent = `Chi dice «${L.varianti[fuoco].variante}»`;
        const r = rampe[fuoco];
        q<HTMLElement>(".hv-ramp-bar").style.background =
          `linear-gradient(90deg, ${[0, .2, .4, .6, .8, 1].map(t => `${r(t)} ${t * 100}%`).join(",")})`;
      }
    }

    // ---- pannello
    function righe(quote: number[], soglia = 0.01) {
      const ord = quote.map((v, j) => [v, j]).sort((a, b) => b[0] - a[0]);
      const box = el("div");
      let resto = 0;
      for (const [v, j] of ord) {
        if (v < soglia) { resto += v; continue; }
        const r = el("div", "p-row");
        const n = el("div", "n");
        const k = el("i"); k.style.background = colori[j];
        n.append(k, el("span", "", L.varianti[j].variante));
        const b = el("div", "b"), f = el("span");
        f.style.width = `${Math.max(1, v * 100)}%`; f.style.background = colori[j];
        b.append(f);
        r.append(n, el("div", "v", pct(v)), b);
        box.append(r);
      }
      if (resto > 0.0005) box.append(el("div", "p-rel", `Altre risposte: ${pct(resto)} in tutto`));
      return box;
    }
    const affidabilita = (n: number) =>
      n >= 30 ? "Stima solida: molte risposte nei dintorni." :
      n >= 8 ? "Stima indicativa: le risposte vicine sono poche decine." :
      "Pochi dati: la stima si appoggia alla media della provincia.";

    function pannello() {
      panel.replaceChildren();
      let titolo: string, kicker: string, quote: number[], neff: number | null = null;
      if (sotto != null) {
        kicker = "Zona di"; titolo = esa[sotto].comune;
        quote = L.quote[sotto].map(v => v / 1000); neff = L.celle[sotto][4];
      } else if (fisso) {
        kicker = "Comune"; titolo = fisso;
        ({ quote, neff } = quoteComune(fisso));
      } else {
        kicker = "Tutta la provincia"; titolo = "Bergamo";
        quote = L.varianti.map(v => v.quota_provincia);
      }
      const top = quote.indexOf(Math.max(...quote));
      panel.append(el("div", "p-k", kicker));
      const t = el("div", "p-t"); t.append(el("span", "", titolo));
      if (fisso && sotto == null) {
        const x = el("button", "p-x", "Chiudi"); x.type = "button";
        x.onclick = () => { fisso = null; q<HTMLInputElement>(".hv-search input").value = ""; aggiorna(); };
        t.append(x);
      }
      panel.append(t);
      panel.append(el("div", "p-k", sotto != null || fisso ? "Qui si dice" : "Si dice soprattutto"));
      panel.append(el("div", "p-big", L.varianti[top].variante));
      panel.append(el("div", "p-bigp", `${pct(quote[top])} delle persone`));
      panel.append(righe(quote));
      if (neff != null) panel.append(el("div", "p-rel", affidabilita(neff)));
    }

    // ---- piccole mappe
    function piccole() {
      const box = q<HTMLElement>(".hv-multiples");
      box.replaceChildren();
      const w = Math.max(150, (box.clientWidth - 14 * 3) / 4);
      for (const j of visibili) {
        const b = el("button", "mm");
        b.type = "button";
        b.setAttribute("aria-pressed", String(fuoco === j));
        b.setAttribute("aria-label", `${L.varianti[j].variante}: ${pct(L.varianti[j].quota_provincia)} in provincia. Mostra sulla mappa grande`);
        const c = el("canvas");
        const p = new Proiezione(esa, Math.min(w, 260) - 20, 400);
        const pl = esa.map(e => e.lon.map((lo, k) => p.px(lo, e.lat[k])));
        const ce = esa.map(e => p.px(e.clon, e.clat));
        b.append(c);
        const t = el("div", "t");
        t.append(el("span", "", L.varianti[j].variante), el("span", "", pct(L.varianti[j].quota_provincia)));
        b.append(t);
        b.onclick = () => {
          fuoco = j; aggiorna();
          wrap.scrollIntoView({ behavior: "smooth", block: "center" });
        };
        box.append(b);
        const ctx = prepara(c, p);
        c.style.width = "100%"; c.style.height = "auto";
        const r = rampe[j];
        disegna(ctx, p, pl, ce, { colore: i => r(L.quote[i][j] / 1000), alfa: i => (L.celle[i][5] ? 0.45 : 1) });
      }
    }

    // ---- tabella e commenti
    function tabella() {
      const tb = q<HTMLElement>(".hv-table tbody");
      tb.replaceChildren();
      for (const c of nomiComuni) {
        const { quote } = quoteComune(c);
        const ord = quote.map((v, j) => [v, j]).sort((a, b) => b[0] - a[0]);
        const tr = el("tr");
        tr.append(el("td", "", c), el("td", "", L.varianti[ord[0][1]].variante), el("td", "num", pct(ord[0][0])),
          el("td", "", ord[1] ? L.varianti[ord[1][1]].variante : "–"), el("td", "num", ord[1] ? pct(ord[1][0]) : ""));
        tb.append(tr);
      }
    }
    const lista = (commenti && commenti[slug]) || [];
    if (lista.length) {
      const box = q<HTMLElement>(".hv-quotes-list");
      for (const c of lista.slice(0, 6)) {
        const f = el("figure");
        f.append(el("blockquote", "", `«${String(c.testo).trim()}»`), el("figcaption", "", c.comune));
        box.append(f);
      }
      q<HTMLElement>(".hv-quotes").hidden = false;
    }

    function aggiorna(tutto = true) {
      disegnaMappa();
      pannello();
      if (tutto) {
        riepilogo();
        root.querySelectorAll<HTMLElement>(".hv-multiples .mm").forEach((b, k) =>
          b.setAttribute("aria-pressed", String(fuoco === visibili[k])));
      }
    }

    // ---- interazione
    function esagonoIn(x: number, y: number) {
      let best = -1, bd = Infinity;
      for (let i = 0; i < centri.length; i++) {
        const dx = centri[i][0] - x, dy = centri[i][1] - y;
        if (Math.abs(dx) > 20 || Math.abs(dy) > 20) continue;
        const d = dx * dx + dy * dy;
        if (d < bd) { bd = d; best = i; }
      }
      if (best < 0) return null;
      const passo = Math.hypot(poli[best][0][0] - centri[best][0], poli[best][0][1] - centri[best][1]);
      return Math.sqrt(bd) <= passo * 1.05 ? best : null;
    }
    const posizione = (ev: PointerEvent) => {
      const r = canvas.getBoundingClientRect();
      return [(ev.clientX - r.left) * (pr.w / r.width), (ev.clientY - r.top) * (pr.h / r.height)];
    };
    canvas.addEventListener("pointermove", ev => {
      if (ev.pointerType !== "mouse") return;
      const [x, y] = posizione(ev);
      const i = esagonoIn(x, y);
      if (i !== sotto) { sotto = i; aggiorna(false); }
    });
    canvas.addEventListener("pointerleave", () => { if (sotto != null) { sotto = null; aggiorna(false); } });
    canvas.addEventListener("click", ev => {
      const [x, y] = posizione(ev as PointerEvent);
      const i = esagonoIn(x, y);
      fisso = i == null ? null : esa[i].comune;
      sotto = null;
      q<HTMLInputElement>(".hv-search input").value = fisso ?? "";
      aggiorna(false);
    });
    q<HTMLInputElement>(".hv-search input").addEventListener("input", ev => {
      const v = (ev.target as HTMLInputElement).value.trim().toLowerCase();
      const c = nomiComuni.find(n => n.toLowerCase() === v);
      if (c) { fisso = c; aggiorna(false); }
    });
    q<HTMLInputElement>(".hv-iso").addEventListener("change", ev => {
      mostraIso = (ev.target as HTMLInputElement).checked; aggiorna(false);
    });
    root.querySelectorAll<HTMLButtonElement>(".hv-seg button").forEach(b => b.addEventListener("click", () => {
      livello = b.dataset.livello as typeof livello;
      root.querySelectorAll(".hv-seg button").forEach(x => x.setAttribute("aria-pressed", String(x === b)));
      impostaLivello(); piccole(); tabella(); aggiorna();
    }));

    impostaLivello();
    layout();
    piccole();
    tabella();
    aggiorna();
    let largPrima = wrap.clientWidth;
    new ResizeObserver(() => {
      if (Math.abs(wrap.clientWidth - largPrima) < 8) return;
      largPrima = wrap.clientWidth;
      layout(); piccole(); aggiorna();
    }).observe(wrap);
  }

  document.querySelectorAll<HTMLElement>(".hexviz").forEach(avvia);
</script>
